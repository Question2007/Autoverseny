<Window x:Class="Autoverseny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Autoverseny"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="start" Content="Start" Width="90" Height="45" Grid.Row="1" Background="CornflowerBlue" Click="start_Click"/>
        <TextBlock x:Name="elozo_nyertes" Text="Előző nyertes: " FontSize="20" FontWeight="Bold" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,20,0"/>
        <ListBox x:Name="rangsor" FontSize="12" FontWeight="Bold" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"></ListBox>
        <Canvas x:Name="palya" Background="LightGray" Grid.Row="4">
            <Button x:Name="ferrari" Content="Ferrari" Width="90" Height="45" Background="Red"
                    Canvas.Left="20" Canvas.Top="50"/>
            <Button x:Name="bugatti" Content="Bugatti" Width="90" Height="45" Background="Blue"
                    Canvas.Left="20" Canvas.Top="120"/>
            <Button x:Name="lamborghini" Content="Lamborghini" Width="90" Height="45" Background="ForestGreen"
                    Canvas.Left="20" Canvas.Top="190"/>
            <Button x:Name="bmw" Content="BMW" Width="90" Height="45" Background="Orchid"
        Canvas.Left="20" Canvas.Top="260"/>
            <Rectangle x:Name="celvonal" Height="334" Canvas.Left="700" Stroke="Black" Width="4" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Canvas>
    </Grid>
</Window>
