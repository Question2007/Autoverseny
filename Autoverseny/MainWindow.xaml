<Window x:Class="Autoverseny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Autoverseny"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF39157D" Offset="0.03"/>
                <GradientStop Color="#FF9E17AD" Offset="0.673"/>
                <GradientStop Color="#FF3D00AD" Offset="1"/>
                <GradientStop Color="#FF3B157E" Offset="0.077"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="start" Content="Start" Width="90" Height="45" Grid.Row="1" Click="start_Click" Foreground="White" FontWeight="Bold">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="#FF030107" Offset="0"/>
                    <GradientStop Color="#FF381479" Offset="1"/>
                    <GradientStop Color="#FF3A147B" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <TextBlock x:Name="elozo_nyertes" Text="Előző nyertes: " FontSize="20" FontWeight="Bold" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="White"/>
        <ListBox x:Name="rangsor" FontSize="12" FontWeight="Bold" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="White">
            <ListBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF3B157E" Offset="1"/>
                </LinearGradientBrush>
            </ListBox.Background>
            <ListBox.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </ListBox.BorderBrush>
        </ListBox>
        <Canvas x:Name="palya" Background="#FFA7A3A3" Grid.Row="4">
            <Button x:Name="ferrari" FontWeight="Bold" Content="Ferrari" Width="90" Height="36" Background="Red"
                    Canvas.Left="20" Canvas.Top="50" Foreground="White"/>
            <Button x:Name="bugatti" FontWeight="Bold" Content="Bugatti" Width="90" Height="45" Background="Blue"
                    Canvas.Left="20" Canvas.Top="120" Foreground="White"/>
            <Button x:Name="lamborghini" FontWeight="Bold" Content="Lamborghini" Width="90" Height="40" Background="ForestGreen"
                    Canvas.Left="20" Canvas.Top="190" BorderBrush="{x:Null}" Foreground="White"/>
            <Button x:Name="bmw" FontWeight="Bold" Content="BMW" Width="90" Height="45" Background="Orchid"
        Canvas.Left="20" Canvas.Top="260" Foreground="White"/>
            <Rectangle x:Name="celvonal" Height="334" Canvas.Left="700" Stroke="Black" Width="4" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="White"/>
        </Canvas>
    </Grid>
</Window>
